{
  "name": "roadwatch-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "storage:configure": "node scripts/configure-storage.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"api/**/*.js\" \"server/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" eslint.config.js playwright.config.js vite.config.js package.json vercel.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"api/**/*.js\" \"server/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" eslint.config.js playwright.config.js vite.config.js package.json vercel.json",
    "lint": "eslint . --max-warnings 0",
    "test": "playwright test",
    "test:preview": "playwright test --project=preview",
    "check": "npm run format:check && npm run lint && npm run build && npm run test:server && npm test",
    "test:server": "node --test tests/server/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^3.4.0"
  }
}
