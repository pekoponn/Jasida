# Project URL dari Supabase Dashboard > Connect.
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) atau legacy anon/public key.
# Jangan gunakan secret atau service_role key di aplikasi browser.
VITE_SUPABASE_ANON_KEY=

# Server Vercel saja, JANGAN gunakan awalan VITE_ untuk secret ini.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Aktifkan hanya jika sengaja mengizinkan reset tanpa bukti kepemilikan email.
ALLOW_EMAIL_ONLY_PASSWORD_RESET=false
